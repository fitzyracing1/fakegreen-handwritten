[6.882776, "o", "\r\n\u001b[1mfakegreen\u001b[22m \u001b[90m·\u001b[39m last commit (8797f43) \u001b[90m· 4/4 files · +5 −13\u001b[39m\r\n\r\n  \u001b[41;97;1m HIGH \u001b[49;39;22m \u001b[1m\u001b[36m.github/workflows/ci.yml\u001b[90m:10\u001b[39m\u001b[39m\u001b[22m  \u001b[35mci-failure-ignored\u001b[39m\r\n         Failure ignored with `|| true` on a test/check command\r\n         \u001b[90m│\u001b[39m \u001b[32m+ - run: npm test || true\u001b[39m\r\n\r\n  \u001b[43;30;1m MED  \u001b[49;39;22m \u001b[1m\u001b[36msrc/cart.ts\u001b[90m:4\u001b[39m\u001b[39m\u001b[22m  \u001b[35msuppression-added\u001b[39m\r\n         Checker silenced with @ts-ignore\r\n         \u001b[90m│\u001b[39m \u001b[32m+ // @ts-ignore\u001b[39m\r\n\r\n  \u001b[41;97;1m HIGH \u001b[49;39;22m \u001b[1m\u001b[36msrc/cart.ts\u001b[90m:5\u001b[39m\u001b[39m\u001b[22m  \u001b[35mtest-env-special-case\u001b[39m\r\n         Non-test code branches on the test env (NODE_ENV === 'test'); tests skip the real path\r\n         \u001b[90m│\u001b[39m \u001b[32m+ if (process.env.NODE_ENV === 'test') return items.length ? 8 : 0;\u001b[39m\r\n\r\n  \u001b[41;97;1m HIGH \u001b[49;39;22m \u001b[1m\u001b[36mtest/cart.test.ts\u001b[90m:9\u001b[39m\u001b[39m\u001b[22m  \u001b[35mtest-skipped\u001b[39m\r\n         Test skipped with .skip\r\n         \u001b[90m│\u001b[39m \u001b[32m+ it.skip('applies SAVE10', () => {\u001b[39m\r\n\r\n  \u001b[41;97;1m HIGH \u001b[49;39;22m \u001b[1m\u001b[36mtest/cart.test.ts\u001b[90m:14\u001b[39m\u001b[39m\u001b[22m  \u001b[35massertion-weakened\u001b[39m\r\n         Specific assertion replaced with a vague one\r\n         \u001b[90m│\u001b[39m \u001b[31m- expect(total([])).toBe(0);\u001b[39m\r\n         \u001b[90m│\u001b[39m \u001b[32m+ expect(total([])).toBeDefined();\u001b[39m\r\n\r\n  \u001b[41;97;1m HIGH \u001b[49;39;22m \u001b[1m\u001b[36mtest/checkout.test.ts\u001b[39m\u001b[22m  \u001b[35mtest-file-deleted\u001b[39m\r\n         Test file deleted (2 test cases removed)\r\n         \u001b[90m│\u001b[39m \u001b[31m- it('rejects negative quantities', () => {\u001b[39m\r\n\r\n  \u001b[31m\u001b[1m5 high\u001b[22m\u001b[39m\u001b[90m · \u001b[39m\u001b[33m\u001b[1m1 medium\u001b[22m\u001b[39m\u001b[90m · \u001b[39m\u001b[90m0 low\u001b[39m  \u001b[31m\u001b[1m✖ fake green detected\u001b[22m\u001b[39m\u001b[90m (fail-on: high)\u001b[39m\u001b[90m · 46ms\u001b[39m\r\n\r\n"]
